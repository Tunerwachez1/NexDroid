#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
set -euo pipefail
base=$(cd -- "$(dirname -- "$0")" && pwd -P)
root="$base/runtime"
# Re-entry from the UI/helper must not mirror the already replaced /usr.
if [[ ${NEXDROID_PRIVATE_RUNTIME:-} == "$base" && /usr/bin/python3 -ef "$root/usr/bin/python3" ]]; then
    exec "$@"
fi
graphics=(--unsetenv LD_LIBRARY_PATH)
if [[ -d /var/lib/nexdroid/gpu/linux64 ]]; then
    graphics=(--setenv LD_LIBRARY_PATH /var/lib/nexdroid/gpu/linux64
              --setenv GBM_BACKENDS_PATH /var/lib/nexdroid/gpu/linux64)
fi
if [[ -f /var/lib/nexdroid/gpu/vulkan-nvidia.json ]]; then
    graphics+=(--setenv VK_DRIVER_FILES /var/lib/nexdroid/gpu/vulkan-nvidia.json)
fi
[[ -x "$root/usr/bin/bwrap" ]] || { echo 'NexDroid runtime is incomplete' >&2; exit 1; }
caps=()
if [[ $EUID == 0 ]]; then
    # Preserve the service's existing capabilities, including systemd drops;
    # do not ask for privileges its bounding set deliberately removed.
    names=(CHOWN DAC_OVERRIDE DAC_READ_SEARCH FOWNER FSETID KILL SETGID SETUID SETPCAP LINUX_IMMUTABLE NET_BIND_SERVICE NET_BROADCAST NET_ADMIN NET_RAW IPC_LOCK IPC_OWNER SYS_MODULE SYS_RAWIO SYS_CHROOT SYS_PTRACE SYS_PACCT SYS_ADMIN SYS_BOOT SYS_NICE SYS_RESOURCE SYS_TIME SYS_TTY_CONFIG MKNOD LEASE AUDIT_WRITE AUDIT_CONTROL SETFCAP MAC_OVERRIDE MAC_ADMIN SYSLOG WAKE_ALARM BLOCK_SUSPEND AUDIT_READ PERFMON BPF CHECKPOINT_RESTORE)
    mask=0
    while read -r key value rest; do
        if [[ $key == CapEff: ]]; then mask=$((16#$value)); break; fi
    done < /proc/self/status
    for i in "${!names[@]}"; do
        if ((mask & (1 << i))); then caps+=(--cap-add "CAP_${names[$i]}"); fi
    done
fi
# Only the runtime's /usr is replaced. Kernel, devices, DBus, user identity and
# persistent Android data remain those of the host. No chroot/setuid frontend.
exec "$root/usr/lib/ld-linux-x86-64.so.2" --library-path "$root/usr/lib" \
    "$root/usr/bin/bwrap" --bind / / --dev-bind /dev /dev "${caps[@]}" \
    --ro-bind /usr "$root/host/usr" \
    --ro-bind-try /lib "$root/host/lib" --ro-bind-try /lib64 "$root/host/lib64" \
    --ro-bind "$root/usr" /usr \
    --dev-bind-try /dev/binderfs /dev/binderfs \
    --ro-bind-try /usr/lib/modules /usr/lib/modules \
    --ro-bind-try /usr/lib/firmware /usr/lib/firmware \
    --ro-bind-try /usr/bin/nvidia-modprobe /usr/bin/nvidia-modprobe \
    --ro-bind-try /usr/share/fonts /usr/share/fonts \
    --ro-bind-try /usr/share/icons /usr/share/icons \
    "${graphics[@]}" --setenv NEXDROID_PRIVATE_RUNTIME "$base" \
    --setenv NEXDROID_HOST_DRIVER_ROOT "$root/host" \
    --setenv NEXDROID_HOST_DRIVER_MANIFEST /var/lib/nexdroid/gpu/host-driver.json \
    --setenv PATH /usr/bin:/usr/sbin:/bin --setenv PYTHONNOUSERSITE 1 \
    --setenv PYTHONDONTWRITEBYTECODE 1 \
    --unsetenv PYTHONPATH --unsetenv PYTHONHOME --unsetenv LD_PRELOAD \
    --unsetenv PYTHONOPTIMIZE \
    -- "$@"
