#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Kernel device preparation must run in the service's host mount namespace.
set -euo pipefail
base=$(cd -- "$(dirname -- "$0")" && pwd)
unset PYTHONPATH PYTHONOPTIMIZE LD_PRELOAD LD_LIBRARY_PATH
export PYTHONHOME="$base/runtime/usr" PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1
exec "$base/runtime/usr/lib/ld-linux-x86-64.so.2" --library-path "$base/runtime/usr/lib" \
    "$base/runtime/usr/bin/python3" "$@"
